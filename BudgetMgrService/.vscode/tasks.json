{
    "version": "2.0.0",
    "tasks": [
        {
            "taskName": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/BudgetMgrService-WebAPI/BudgetMgrService-WebAPI.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "taskName": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "xunit",
                "${workspaceFolder}/BudgetMgrServiceLibTest/BudgetMgrServiceLibTest.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}